{
  "description": "TurnRelevancy with window_size 2: one window irrelevant, one verdict out of vocabulary and dropped; the turns carry tools, context and metadata",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "turn_relevancy",
    "params": {
      "window_size": 2,
      "threshold": 0.7
    }
  },
  "test_case": {
    "turns": [
      {
        "role": "user",
        "content": "Hi! I'd like to change my café booking."
      },
      {
        "role": "assistant",
        "content": "Sure, which booking?",
        "metadata": {
          "latency": "fast"
        }
      },
      {
        "role": "user",
        "content": "The one on Friday, for two."
      },
      {
        "role": "assistant",
        "content": "Have you tried our new pizza?",
        "retrieval_context": [
          "Pizza promo: 2 for 1.",
          {
            "context": "Booking 7 is on Friday.",
            "source": "bookings.db"
          }
        ],
        "tools_called": [
          {
            "name": "promo_lookup",
            "input_parameters": {
              "item": "pizza"
            },
            "output": {
              "deal": "2 for 1"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": "That's not what I asked."
      },
      {
        "role": "assistant",
        "content": "Sorry! I've moved booking 7 to Saturday.",
        "user_id": "agent-3",
        "latency_ms": 820
      }
    ]
  },
  "responses": {
    "turn_relevancy": {
      "reason,verdict": [
        {
          "verdict": "yes"
        },
        {
          "verdict": "no",
          "reason": "The assistant advertises pizza instead of changing the booking."
        },
        "{\"verdict\": \"maybe\", \"reason\": \"Unsure.\"}"
      ],
      "reason": [
        {
          "reason": "The score is 0.5 because message 2 advertises pizza instead of changing the booking."
        }
      ]
    }
  }
}
