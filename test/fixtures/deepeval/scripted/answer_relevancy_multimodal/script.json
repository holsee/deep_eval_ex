{
  "description": "AnswerRelevancy: a multimodal test case, its images exported as imagesMapping",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "answer_relevancy",
    "params": {
      "threshold": 0.5
    }
  },
  "test_case": {
    "input": "What does the chart [DEEPEVAL:IMAGE:sales-chart] show?",
    "actual_output": "Sales doubled in 2024. The chart is blue.",
    "images": [
      {
        "url": "https://example.com/charts/sales.png",
        "_id": "sales-chart"
      },
      {
        "dataBase64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFBQIAX8jx0gAAAABJRU5ErkJggg==",
        "mimeType": "image/png",
        "_id": "red-dot"
      }
    ]
  },
  "responses": {
    "answer_relevancy": {
      "statements": [
        {
          "statements": [
            "Sales doubled in 2024.",
            "The chart is blue."
          ]
        }
      ],
      "verdicts": [
        {
          "verdicts": [
            {
              "verdict": "yes"
            },
            {
              "verdict": "no",
              "reason": "The colour of the chart does not say what it shows."
            }
          ]
        }
      ],
      "reason": [
        {
          "reason": "The score is 0.50 because the chart's colour is irrelevant."
        }
      ]
    }
  }
}
