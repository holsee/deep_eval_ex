{
  "description": "TurnContextualRecall in strict mode without reasons: a window below 1 scores 0",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "turn_contextual_recall",
    "params": {
      "strict_mode": true,
      "include_reason": false
    }
  },
  "test_case": {
    "expected_outcome": "Order 42 shipped on 1 October. Refunds take 5 business days.",
    "turns": [
      {
        "role": "user",
        "content": "Where is order 42?"
      },
      {
        "role": "assistant",
        "content": "It shipped on 1 October.",
        "retrieval_context": [
          "Order 42 shipped on 1 October."
        ]
      },
      {
        "role": "user",
        "content": "And a refund?"
      },
      {
        "role": "assistant",
        "content": "Refunds take 5 business days.",
        "retrieval_context": [
          "Refunds take 5 business days."
        ]
      }
    ]
  },
  "responses": {
    "turn_contextual_recall": {
      "verdicts": [
        {
          "verdicts": [
            {
              "verdict": "yes",
              "reason": "The 1st node gives the date."
            },
            {
              "verdict": "no",
              "reason": "No node mentions refunds."
            }
          ]
        },
        {
          "verdicts": [
            {
              "verdict": "yes",
              "reason": "The 1st node gives the date."
            },
            {
              "verdict": "yes",
              "reason": "The 2nd node gives the refund time."
            }
          ]
        }
      ]
    }
  }
}
