{
  "description": "AgentLoopDetection: an agent delegating back to itself with the same input (the label's input hash cut at 64 characters), its name holding a colon",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "agent_loop_detection",
    "params": {
      "threshold": 0.5
    }
  },
  "test_case": {
    "input": "How do I reset my password?",
    "actual_output": "Use the 'Forgot password' link on the login page."
  },
  "trace": {
    "name": "kb:planner",
    "type": "agent",
    "input": {
      "goal": "Find the password reset steps in the help centre and answer the user, attempt 1"
    },
    "output": "Done",
    "available_tools": [],
    "agent_handoffs": [],
    "children": [
      {
        "name": "planner",
        "type": "agent",
        "input": {
          "goal": "other"
        },
        "output": "x",
        "available_tools": [],
        "agent_handoffs": [],
        "children": []
      },
      {
        "name": "delegate",
        "type": "tool",
        "input": {
          "to": "kb:planner"
        },
        "output": "ok",
        "children": [
          {
            "name": "kb:planner",
            "type": "agent",
            "input": {
              "goal": "Find the password reset steps in the help centre and answer the user, attempt 2"
            },
            "output": "Done",
            "available_tools": [],
            "agent_handoffs": [],
            "children": []
          }
        ]
      }
    ]
  },
  "responses": {}
}
