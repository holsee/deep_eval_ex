{
  "description": "KnowledgeRetention in strict mode: a forgotten fact without a reason clamps the score to the integer 0",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "knowledge_retention",
    "params": {
      "strict_mode": true
    }
  },
  "test_case": {
    "turns": [
      {
        "role": "user",
        "content": "I'm allergic to peanuts."
      },
      {
        "role": "assistant",
        "content": "Would you like our peanut satay?"
      }
    ]
  },
  "responses": {
    "knowledge_retention": {
      "data": [
        {
          "data": {
            "Allergies": [
              "Peanuts"
            ]
          }
        }
      ],
      "reason,verdict": [
        {
          "verdict": "yes"
        }
      ],
      "reason": [
        {
          "reason": "The score is 0.00 because the LLM offers peanuts."
        }
      ]
    }
  }
}
