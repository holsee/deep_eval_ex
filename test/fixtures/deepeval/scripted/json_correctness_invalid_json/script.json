{
  "description": "JsonCorrectness: an output that is not JSON at all; the judge writes the reason",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "json_correctness",
    "params": {
      "expected_schema": {
        "$defs": {
          "Address": {
            "properties": {
              "city": {
                "title": "City",
                "type": "string"
              },
              "postcode": {
                "title": "Postcode",
                "type": "string"
              }
            },
            "required": [
              "city",
              "postcode"
            ],
            "title": "Address",
            "type": "object"
          }
        },
        "properties": {
          "name": {
            "description": "Full name, e.g. José Saramago",
            "title": "Name",
            "type": "string"
          },
          "age": {
            "title": "Age",
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "address": {
            "$ref": "#/$defs/Address"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Nickname"
          }
        },
        "required": [
          "name",
          "age",
          "tags",
          "address"
        ],
        "title": "Person",
        "type": "object"
      }
    }
  },
  "test_case": {
    "input": "Return the customer's profile as JSON.",
    "actual_output": "Sure! Here is the profile: {\"name\": \"José Saramago\", \"age\": 87"
  },
  "responses": {
    "json_correctness": {
      "reason": [
        {
          "reason": "The generated Json is not valid because it is prose followed by an unterminated object, not JSON."
        }
      ]
    }
  }
}
