{
  "description": "TurnContextualRecall with window_size 1: an unsupported sentence, a RetrievedContextData node, a window without retrieval context and a raw-text verdict out of vocabulary dropped",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "turn_contextual_recall",
    "params": {
      "window_size": 1,
      "threshold": 0.6
    }
  },
  "test_case": {
    "expected_outcome": "Order 42 shipped on 1 October. Refunds take 5 business days.",
    "turns": [
      {
        "role": "user",
        "content": "Where is order 42?"
      },
      {
        "role": "assistant",
        "content": "It shipped on 1 October.",
        "retrieval_context": [
          {
            "context": "Order 42 shipped on 1 October.",
            "source": "orders.db"
          }
        ]
      },
      {
        "role": "user",
        "content": "Thanks."
      },
      {
        "role": "assistant",
        "content": "You're welcome!"
      },
      {
        "role": "user",
        "content": "And a refund?"
      },
      {
        "role": "assistant",
        "content": "Refunds are instant.",
        "retrieval_context": [
          "Our café is open late."
        ]
      }
    ]
  },
  "responses": {
    "turn_contextual_recall": {
      "verdicts": [
        {
          "verdicts": [
            {
              "verdict": "yes",
              "reason": "The 1st node gives the date."
            },
            {
              "verdict": "no",
              "reason": "No node mentions refunds."
            }
          ]
        },
        "{\"verdicts\": [{\"verdict\": \"no\", \"reason\": \"The café node says nothing about order 42.\"}, {\"verdict\": \"unsure\", \"reason\": \"Refunds are not mentioned.\"}]}"
      ],
      "reason": [
        {
          "reason": "The score is 0.50 because refunds are not covered."
        },
        {
          "reason": "The score is 0.00 because nothing is covered."
        },
        {
          "reason": "The score is 0.5 because the refund sentence is never supported."
        }
      ]
    }
  }
}
