{
  "description": "ToolCorrectness in strict mode with ordering and exact match",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "tool_correctness",
    "params": {
      "strict_mode": true,
      "should_consider_ordering": true
    }
  },
  "test_case": {
    "input": "What's the weather in Paris?",
    "actual_output": "It is 18°C in Paris.",
    "tools_called": [
      {
        "name": "search_web",
        "input_parameters": {
          "query": "Paris weather"
        }
      }
    ],
    "expected_tools": [
      {
        "name": "get_weather",
        "input_parameters": {
          "city": "Paris"
        }
      },
      {
        "name": "format_answer"
      }
    ]
  },
  "responses": {}
}
