{
  "description": "ArgumentCorrectness in strict mode: one wrong argument fails the test case",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "argument_correctness",
    "params": {
      "strict_mode": true
    }
  },
  "test_case": {
    "input": "Convert 100 USD to EUR.",
    "tools_called": [
      {
        "name": "get_rate",
        "input_parameters": {
          "from": "USD",
          "to": "EUR"
        }
      },
      {
        "name": "multiply",
        "input_parameters": {
          "a": 100,
          "b": 1.5
        }
      }
    ]
  },
  "responses": {
    "argument_correctness": {
      "verdicts": [
        {
          "verdicts": [
            {
              "verdict": "yes"
            },
            {
              "verdict": "no",
              "reason": "1.5 is not the USD to EUR rate get_rate returned."
            }
          ]
        }
      ],
      "reason": [
        {
          "reason": "The score is 0.00 because the conversion multiplies by a made-up rate."
        }
      ]
    }
  }
}
