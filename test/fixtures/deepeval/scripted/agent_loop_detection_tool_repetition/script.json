        "type": "tool",
        "input": "{\"limit\": 5, \"query\": \"reset password\", \"filters\": {\"lang\": \"en\"}}",
        "output": [
          "Password reset article"
        ],
        "children": []
      },
      {
        "name": "lookup",
        "type": "tool",
        "input": {
          "query": "reset password",
          "limit": "5",
          "filters": {
            "lang": "en"
          }
        },
        "output": [
          "Password reset article"
        ],
        "children": []
      },
      {
        "name": "think",
        "type": "llm",
        "input": {},
