{
  "description": "AgentLoopDetection: one tool called three times with the same arguments, in another key order and once as a JSON string",
  "judge_model": "scripted-judge",
  "metric": {
    "kind": "agent_loop_detection",
    "params": {
      "threshold": 0.5
    }
  },
  "test_case": {
    "input": "How do I reset my password?",
    "actual_output": "Use the 'Forgot password' link on the login page."
  },
  "trace": {
