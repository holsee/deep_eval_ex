    },
    "output": "Use the 'Forgot password' link on the login page.",
    "available_tools": [
      "search",
      "lookup"
    ],
    "agent_handoffs": [],
    "children": [
      {
        "name": "search",
        "type": "tool",
        "input": {
          "query": "reset password",
          "limit": 5,
