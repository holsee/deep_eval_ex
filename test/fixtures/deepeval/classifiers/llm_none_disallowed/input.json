{
  "description": "NONE without allow_none is an undeclared label: an error",
  "classifier": {
    "kind": "classifier",
    "eval_mode": "llm",
    "params": {
      "name": "ticket_type",
      "labels": [
        {
          "name": "billing",
          "description": "Questions about invoices, charges or refunds."
        },
        "technical",
        {
          "name": "Account Access",
          "description": "Logging in, passwords and two-factor codes."
        }
      ]
    }
  },
  "test_case": {
    "input": "What's the weather like?",
    "actual_output": "Sunny, 24C.",
    "expected_labels": {
      "ticket_type": "technical"
    }
