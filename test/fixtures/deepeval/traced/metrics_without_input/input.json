{
  "description": "Span metrics on a zero-argument span, whose input is {}: sync builds a test case from it (`is not None`), async does not (truthiness) and reports the missing LLMTestCase",
  "goldens": [
    {
      "input": "How do I reset my password?",
      "expected_output": "Use the 'Forgot password' link.",
      "name": "password-reset"
    }
  ],
  "metrics": [
    {
      "kind": "stub",
      "name": "Stub Judge",
      "score": 0.75,
      "reason": "Three of the four statements are supported. café ✓",
      "threshold": 0.7,
      "evaluation_model": "gpt-4o-mini",
      "evaluation_cost": 0.000321,
      "input_tokens": 1234,
      "output_tokens": 56
    }
  ],
  "modes": [
    "sync",
    "async"
  ],
  "functions": {
    "agent": {
      "type": "agent",
      "params": [
        [
          "query"
        ]
      ],
      "body": [
        {
          "call": "ping"
        }
      ],
      "returns": "pong for {query}"
    },
    "ping": {
      "metrics": [
        {
          "kind": "stub",
          "name": "Span Judge",
          "score": 0.75,
          "reason": "Three of the four statements are supported. café ✓",
          "threshold": 0.7,
          "evaluation_model": "gpt-4o-mini",
          "evaluation_cost": 0.000321,
          "input_tokens": 1234,
          "output_tokens": 56
        }
      ],
      "returns": "pong"
    }
  },
  "app": [
    {
      "call": "agent",
      "args": [
        "{input}"
      ]
    }
  ]
}
