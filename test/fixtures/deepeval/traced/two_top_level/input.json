{
  "description": "Two top-level spans per golden: sync keeps the wrapper span's first child only (root_spans[0].children[0]); async evaluates each trace as its own test case",
  "goldens": [
    {
      "input": "How do I reset my password?",
      "expected_output": "Use the 'Forgot password' link.",
      "name": "password-reset"
    }
  ],
  "metrics": [
    {
      "kind": "stub",
      "name": "Stub Judge",
      "score": 0.75,
      "reason": "Three of the four statements are supported. café ✓",
      "threshold": 0.7,
      "evaluation_model": "gpt-4o-mini",
      "evaluation_cost": 0.000321,
      "input_tokens": 1234,
      "output_tokens": 56
    }
  ],
  "modes": [
    "sync",
    "async"
  ],
  "functions": {
    "first": {
      "type": "agent",
      "params": [
        [
          "query"
        ]
      ],
      "metrics": [
        {
          "kind": "stub",
          "name": "Span Judge",
          "score": 0.75,
          "reason": "Three of the four statements are supported. café ✓",
          "threshold": 0.7,
          "evaluation_model": "gpt-4o-mini",
          "evaluation_cost": 0.000321,
          "input_tokens": 1234,
          "output_tokens": 56
        }
      ],
      "returns": "first answer to {query}"
    },
    "second": {
      "type": "agent",
      "params": [
        [
          "query"
        ]
      ],
      "metrics": [
        {
          "kind": "stub",
          "name": "Strict Judge",
          "score": 0.5,
          "reason": "Half of the claims are supported.",
          "threshold": 0.9,
          "evaluation_model": "gpt-4o",
          "evaluation_cost": 0.0025,
          "input_tokens": 2048,
          "output_tokens": 128
        }
      ],
      "returns": "second answer to {query}"
    }
  },
  "app": [
    {
      "call": "first",
      "args": [
        "{input}"
      ]
    },
    {
      "call": "second",
      "args": [
        "{input}"
      ]
    }
  ]
}
