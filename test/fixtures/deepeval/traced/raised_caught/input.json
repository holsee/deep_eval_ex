{
  "description": "A tool that raises inside an agent that catches it: the tool span is ERRORED with str(exception) and its metrics skipped, the agent and the trace succeed",
  "goldens": [
    {
      "input": "How do I reset my password?",
      "expected_output": "Use the 'Forgot password' link.",
      "name": "password-reset"
    }
  ],
  "metrics": [
    {
      "kind": "stub",
      "name": "Stub Judge",
      "score": 0.75,
      "reason": "Three of the four statements are supported. café ✓",
      "threshold": 0.7,
      "evaluation_model": "gpt-4o-mini",
      "evaluation_cost": 0.000321,
      "input_tokens": 1234,
      "output_tokens": 56
    }
  ],
  "modes": [
    "sync",
    "async"
  ],
  "functions": {
    "agent": {
      "type": "agent",
      "params": [
        [
          "query"
        ]
      ],
      "body": [
        {
          "call": "flaky_tool",
          "args": [
            "$query"
          ],
          "catch": true
        }
      ],
      "returns": "Recovered from a failed lookup"
    },
    "flaky_tool": {
      "type": "tool",
      "params": [
        [
          "query"
        ]
      ],
      "metrics": [
        {
          "kind": "stub",
          "name": "Span Judge",
          "score": 0.75,
          "reason": "Three of the four statements are supported. café ✓",
          "threshold": 0.7,
          "evaluation_model": "gpt-4o-mini",
          "evaluation_cost": 0.000321,
          "input_tokens": 1234,
          "output_tokens": 56
        }
      ],
      "body": [
        {
          "raise": {
            "type": "ValueError",
            "message": "upstream timeout"
          }
        }
      ]
    }
  },
  "app": [
    {
      "call": "agent",
      "args": [
        "{input}"
      ]
    }
  ]
}
