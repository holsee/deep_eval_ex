{
  "description": "ArgumentCorrectness in hybrid mode with Jev down: the LLM takes the verdicts",
  "metrics": [
    {
      "kind": "argument_correctness",
      "eval_mode": "hybrid",
      "params": {
        "threshold": 0.5
      }
    }
  ],
  "test_case": {
    "input": "Book a table for two in Zürich on Friday.",
    "actual_output": "Your table at Café Odéon is booked for Saturday.",
    "tools_called": [
      {
        "name": "restaurant_search",
        "description": "Find restaurants in a city",
        "input_parameters": {
          "city": "Zürich",
          "party_size": 2
        }
      },
      {
        "name": "book_table",
        "input_parameters": {
          "day": "Saturday",
          "restaurant": "Café Odéon"
        },
        "output": "Booked for Saturday at 19:00"
      }
    ]
  },
  "system_one": {
    "model": "exploding-jev",
    "raises": {
      "type": "ConnectionError",
      "message": "Jev is down"
    }
  },
  "judge_model": "scripted-judge",
  "responses": {
    "argument_correctness": {
      "reason": [
        {
          "reason": "The score is 0.50 because the booking is for Saturday, not Friday."
        }
      ],
      "verdicts": [
        {
          "verdicts": [
            {
              "verdict": "yes"
            },
            {
              "verdict": "no",
              "reason": "It books Saturday, not Friday."
            }
          ]
        }
      ]
    }
  }
}
