      "intentions": [
        {
          "intentions": [
            "User wants to know where order 42 is",
            "User wants to change the delivery address to Zürich"
          ]
        }
      ],
      "reason": [
        {
          "reason": "The score is 1.0 because the LLM explains the delay and changes the address."
        }
