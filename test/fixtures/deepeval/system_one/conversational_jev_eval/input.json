{
  "description": "ConversationalJevEval about the turns and the chatbot_role: a weighted Noul, a Score and a Choice",
  "metrics": [
    {
      "kind": "conversational_jev_eval",
      "params": {
        "name": "Travel Agent",
        "evaluation_params": [
          "chatbot_role"
        ],
        "threshold": 0.7,
        "questions": [
          {
            "type": "noul",
            "statement": "The assistant remembers what the user told it.",
            "weight": 2
          },
          {
            "type": "score",
            "question": "How well do the assistant's turns keep to `chatbot_role`?",
            "levels": [
              "Not at all",
              "Partly",
              "Fully"
            ]
          },
          {
            "type": "choice",
            "question": "How does the assistant end the conversation?",
            "options": {
              "confirms_the_booking": 1.0,
              "asks_again": 0.0,
              "still_open": null
            }
          }
        ]
      }
    }
  ],
  "test_case": {
    "chatbot_role": "A cheerful travel agent who keeps every reply short.",
    "turns": [
      {
        "role": "user",
        "content": "I'm flying to Lisbon on 3 May."
      },
      {
        "role": "assistant",
        "content": "Lovely! Where are you flying to?"
      },
      {
        "role": "user",
        "content": "Lisbon. I'm vegetarian, too."
      },
      {
        "role": "assistant",
        "content": "Noted: a vegetarian meal to Lisbon on 3 May. Bon voyage!"
      }
    ]
  },
  "system_one": {
    "model": "fake-jev",
    "cost": {
      "value": 4.2e-05,
      "input_tokens": 1000,
      "output_tokens": 0
    },
    "answers": {
      "nouls": {
        "q_0": {
          "probability": 0.35
        }
      },
      "scores": {
        "q_1": {
          "score": 1.8,
          "probabilities": {
            "0": 0.05,
            "1": 0.1,
            "2": 0.85
          },
          "confidence": 0.8
        }
      },
      "choices": {
        "q_2": {
          "choice": "confirms_the_booking",
          "probabilities": {
            "confirms_the_booking": 0.7,
            "asks_again": 0.2,
            "still_open": 0.1
          },
          "confidence": 0.6
        }
      }
    }
  }
}
