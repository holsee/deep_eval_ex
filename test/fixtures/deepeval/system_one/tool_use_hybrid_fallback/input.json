{
  "description": "ToolUse in hybrid mode with Jev down: the LLM takes every score",
  "metrics": [
    {
      "kind": "tool_use",
      "eval_mode": "hybrid",
      "params": {
        "threshold": 0.5,
        "available_tools": [
          {
            "name": "book_table",
            "description": "Book a restaurant table"
          },
          {
            "name": "search_web",
            "description": "Search the web"
          }
        ]
      }
    }
  ],
  "test_case": {
    "turns": [
      {
        "role": "user",
        "content": "Book a table for two at Café Odéon on Saturday."
      },
      {
        "role": "assistant",
        "content": "Booked: Saturday at 19:00, for two.",
        "tools_called": [
          {
            "name": "book_table",
            "input_parameters": {
              "day": "Saturday",
              "restaurant": "Café Odéon"
            },
            "output": "Booked for Saturday at 19:00"
          }
        ]
      },
      {
        "role": "user",
        "content": "What's the address?"
      },
      {
        "role": "assistant",
        "content": "12 Rue de l'Odéon, Paris."
      }
    ]
  },
  "system_one": {
    "model": "exploding-jev",
    "raises": {
      "type": "ConnectionError",
      "message": "Jev is down"
    }
  },
  "judge_model": "scripted-judge",
  "responses": {
    "tool_use": {
      "reason,score": [
        {
          "score": 1.0,
          "reason": "book_table was the right tool."
        },
        {
          "score": 0.75,
          "reason": "No tool was needed for the address."
        },
        {
          "score": 0.5,
          "reason": "The party size is missing."
        }
      ],
      "reason": [
        {
          "reason": "The score is 0.5 because book_table was well chosen."
        },
        {
          "reason": "The score is 0.5 because the party size is missing."
        }
      ]
    }
  }
}
