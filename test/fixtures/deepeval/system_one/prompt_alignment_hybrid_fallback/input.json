{
  "description": "PromptAlignment in hybrid mode with Jev down: the LLM takes the verdicts",
  "metrics": [
    {
      "kind": "prompt_alignment",
      "eval_mode": "hybrid",
      "params": {
        "threshold": 0.5,
        "prompt_instructions": [
          "Reply in English.",
          "Respond in all upper case.",
          "Use the word 'welcome'."
        ]
      }
    }
  ],
  "test_case": {
    "input": "Say hello to the new team member.",
    "actual_output": "Hello and welcome to the team!"
  },
  "system_one": {
    "model": "exploding-jev",
    "raises": {
      "type": "ConnectionError",
      "message": "Jev is down"
    }
  },
  "judge_model": "scripted-judge",
  "responses": {
    "prompt_alignment": {
      "reason": [
        {
          "reason": "The score is 0.67 because the output is not in upper case."
        }
      ],
      "verdicts": [
        {
          "verdicts": [
            {
              "verdict": "yes"
            },
            {
              "verdict": "no",
              "reason": "The output is not in upper case."
            },
            {
              "verdict": "yes"
            }
          ]
        }
      ]
    }
  }
}
