# Copy to .devcontainer/.env (gitignored) and fill in only what you use.
# Values may be literals or 1Password secret references, e.g.
#   OPENAI_API_KEY=op://<vault>/<item>/credential
# which .devcontainer/resolve-env.sh resolves with `op inject` into the
# gitignored .devcontainer/.env.resolved when the container is created.
# Recreate the container after edits:
#   devcontainer up --workspace-folder . --remove-existing-container
# Write KEY=value with no quotes and no `export` (Docker env-file syntax:
# quotes become part of the value). Blank values are treated as unset by the
# adapters.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Judge models of `mix test --only live` (each adapter's default when blank;
# behind a gateway, the model IDs it publishes).
DEEP_EVAL_LIVE_OPENAI_MODEL=
DEEP_EVAL_LIVE_ANTHROPIC_MODEL=
# The ReqLLM case of `mix test --only live`, skipped when the model is blank:
# a ReqLLM spec such as google:gemini-2.5-flash, or, through an
# OpenAI-compatible gateway, openai:<the gateway's model ID> with the base URL
# set to OPENAI_BASE_URL's value and the wire to openai_responses (or
# openai_chat). The key comes from the provider's usual variable
# (OPENAI_API_KEY for openai:).
DEEP_EVAL_LIVE_REQLLM_MODEL=
DEEP_EVAL_LIVE_REQLLM_BASE_URL=
DEEP_EVAL_LIVE_REQLLM_WIRE=
# The Ollama case of `mix test --only live` runs when both are set. A local
# server in Docker on the host (see test/deep_eval_ex/live_test.exs), reached
# from the container:
#   OLLAMA_HOST=http://host.docker.internal:11435
#   DEEP_EVAL_LIVE_OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_HOST=
DEEP_EVAL_LIVE_OLLAMA_MODEL=
# TypeSafe System One (Jev), for `mix test --only live_system_one`.
# TYPESAFE_MODEL_NAME defaults to jev-latest when blank. Its hybrid check
# also needs OPENAI_API_KEY (and OPENAI_BASE_URL, DEEP_EVAL_LIVE_OPENAI_MODEL
# as above) for the LLM judge.
TYPESAFE_API_KEY=
TYPESAFE_MODEL_NAME=
