# Copy to .devcontainer/.env (gitignored) and fill in only what you use.
# Loaded into the dev container at creation; recreate the container after edits:
#   devcontainer up --workspace-folder . --remove-existing-container
# Blank values are treated as unset by the adapters.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OLLAMA_HOST=
