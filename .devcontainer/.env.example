# Copy to .devcontainer/.env (gitignored) and fill in only what you use.
# Values may be literals or 1Password secret references, e.g.
#   OPENAI_API_KEY=op://<vault>/<item>/credential
# which .devcontainer/resolve-env.sh resolves with `op inject` into the
# gitignored .devcontainer/.env.resolved when the container is created.
# Recreate the container after edits:
#   devcontainer up --workspace-folder . --remove-existing-container
# Write KEY=value with no quotes and no `export` (Docker env-file syntax:
# quotes become part of the value). Blank values are treated as unset by the
# adapters.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OLLAMA_HOST=
